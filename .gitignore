# User/local project state
local/

# Emacs backups/autosave
*~
\#*\#
.\#*

# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Build/distribution artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
.venv312/
venv/
env/
ENV/

